# Local development uses SQLite — no external database to set up.
DATABASE_URL="file:./dev.db"

# For a hosted deploy (Neon / Postgres), use a Postgres connection string
# instead, set the datasource provider to "postgresql" in prisma/schema.prisma,
# and switch the adapter in src/lib/db.ts to @prisma/adapter-pg. See README.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

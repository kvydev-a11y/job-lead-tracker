# Local development uses SQLite — no external database to set up.
DATABASE_URL="file:./dev.db"

# For a hosted deploy (Neon / Postgres), use a Postgres connection string
# instead, set the datasource provider to "postgresql" in prisma/schema.prisma,
# and switch the adapter in src/lib/db.ts to @prisma/adapter-pg. See README.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Gmail ingestion (Phase 2) ---
# Create an OAuth client in Google Cloud Console (see README) and paste here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Public origin used to build the OAuth redirect when GOOGLE_REDIRECT_URI is unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated sender emails/domains whose mail is curated job leads
# (e.g. Sarthak's agent). Matched addresses become Leads.
LEAD_SENDERS=""

# Shared secret the ingestion cron must present (Authorization: Bearer <secret>
# or ?secret=). Leave empty for local dev to run it unauthenticated.
CRON_SECRET=""
